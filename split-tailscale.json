{
  "log": {
    "level": "debug"
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "dns-control"
      }
    ],
    "strategy": "ipv4_only",
    "final": "dns-control"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30"
      ],
      "auto_route": true,
      "stack": "gvisor",
      "mtu": 1280,
      "include_package": [
        "com.openai.chatgpt",
        "org.telegram.messenger",
        "org.telegram.messenger.web"
      ]
    },
    {
      "type": "socks",
      "tag": "ts-bootstrap-in",
      "listen": "127.0.0.1",
      "listen_port": 19321
    }
  ],
  "endpoints": [
    {
      "type": "tailscale",
      "tag": "home-exit",
      "state_directory": "tailscale-split-state",
      "exit_node": "home-vpn-exit",
      "detour": "ts-bootstrap-out"
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "socks",
      "tag": "ts-bootstrap-out",
      "server": "127.0.0.1",
      "server_port": 19321,
      "version": "5"
    }
  ],
  "route": {
    "default_domain_resolver": "dns-control",
    "rules": [
      {
        "inbound": [
          "ts-bootstrap-in"
        ],
        "network": [
          "tcp"
        ],
        "port": [
          80
        ],
        "action": "reject",
        "no_drop": true
      },
      {
        "inbound": [
          "ts-bootstrap-in"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      }
    ],
    "final": "home-exit"
  }
}
