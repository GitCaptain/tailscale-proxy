{
  "log": {
    "level": "debug"
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "dns-control"
      },
      {
        "type": "https",
        "tag": "dns-via-vpn",
        "server": "1.1.1.1",
        "path": "/dns-query",
        "tls": {
          "enabled": true
        },
        "detour": "home-exit"
      }
    ],
    "strategy": "ipv4_only",
    "final": "dns-via-vpn"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30"
      ],
      "auto_route": true,
      "stack": "gvisor",
      "mtu": 1280,
      "include_package": [
        "com.openai.chatgpt",
        "org.telegram.messenger",
        "org.telegram.messenger.web"
      ]
    }
  ],
  "endpoints": [
    {
      "type": "tailscale",
      "tag": "home-exit",
      "state_directory": "tailscale-split-state",
      "exit_node": "home-vpn-exit"
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "default_domain_resolver": "dns-control",
    "rules": [
      {
        "protocol": "dns",
        "action": "hijack-dns"
      }
    ],
    "final": "home-exit"
  }
}
